# AuShadha 2.0 Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-new-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=aushadha2
DB_USER=aushadha
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Application Settings
APP_ROOT_URL=/AuShadha/
TIME_ZONE=UTC

# Security Settings (Production)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Optional: Email Configuration
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# Optional: Static/Media Files
# STATIC_ROOT=/var/www/aushadha/static
# MEDIA_ROOT=/var/www/aushadha/media
